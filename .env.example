# Copia este archivo a .env en el servidor (nano .env) y llénalo. NUNCA lo subas a GitHub ni lo pegues en un chat.
XS_PUBLIC_HOST=xscript.detonantevfx.com
ACME_EMAIL=tu-correo@ejemplo.com
# Correos dueños (separados por coma). Ellos siempre pueden entrar y crear proyectos.
XS_OWNER_EMAILS=tu-correo@ejemplo.com
# Login con Google (Google Cloud → Credenciales → ID de cliente OAuth, tipo "Aplicación web").
XS_GOOGLE_CLIENT_ID=
XS_GOOGLE_CLIENT_SECRET=
# Hetzner Object Storage (bucket privado). Sin esto, los PDFs y el historial se guardan en el disco del servidor.
XS_S3_BUCKET=xscript
XS_S3_HOST=hel1.your-objectstorage.com
XS_S3_REGION=hel1
XS_S3_ACCESS_KEY=
XS_S3_SECRET_KEY=
# Alertas por correo (opcional, con Resend como en Shoter)
XS_ALERT_EMAIL=
RESEND_API_KEY=
